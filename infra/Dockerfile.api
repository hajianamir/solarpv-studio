# Stage 1: Build Rust core library
FROM rust:1.79-bullseye AS rust-builder
WORKDIR /app/rust
COPY src/core-engine .
RUN cargo build --release

# Stage 2: Build .NET API
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS dotnet-builder
WORKDIR /app/dotnet
COPY src/backend .
RUN dotnet publish SolarPv.Api/SolarPv.Api.csproj -c Release -o /app/publish

# Stage 3: Runtime image
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app
COPY --from=dotnet-builder /app/publish .
COPY --from=rust-builder /app/rust/target/release/libpv_ffi.so /app/libpv_ffi.so
ENV LD_LIBRARY_PATH=/app:$LD_LIBRARY_PATH
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "SolarPv.Api.dll"]
