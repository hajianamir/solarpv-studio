@using System.Net.Http.Json
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@inject IHttpClientFactory HttpClientFactory

<div class="card">
    <h2>Interactive 3D Site & Shading Viewer</h2>
    <div id="three-container"></div>
    <div style="margin-top: 10px;">
        <button @onclick="RunShadingAnalysis">Run Ray-Traced Shading Analysis</button>
    </div>

    @if (shadingResult != null)
    {
        <div class="result-box">
            <h3>Shading Factor: @(shadingResult.Value.ToString("P1"))</h3>
            <p>Calculated via Rust BVH Ray-Tracer Core Engine</p>
        </div>
    }
</div>

@code {
    private double? shadingResult;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("initThreeViewer", "three-container");
        }
    }

    private async Task RunShadingAnalysis()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("SolarPvApi");
            var req = new
            {
                MeshTriangles = new[]
                {
                    new { V0 = new { X = -1.0, Y = 1.0, Z = 2.0 }, V1 = new { X = 1.0, Y = 1.0, Z = 2.0 }, V2 = new { X = 0.0, Y = -1.0, Z = 2.0 } }
                },
                TargetPoints = new[] { new { X = 0.0, Y = 0.0, Z = 0.0 } },
                SunDirections = new[] { new { X = 0.0, Y = 0.0, Z = 1.0 } }
            };

            var res = await client.PostAsJsonAsync("/api/v1/shading/analyze", req);
            if (res.IsSuccessStatusCode)
            {
                var body = await res.Content.ReadFromJsonAsync<ShadingResponse>();
                if (body != null && body.ShadingFactors != null && body.ShadingFactors.Count > 0)
                {
                    shadingResult = body.ShadingFactors[0];
                }
            }
        }
        catch
        {
            shadingResult = 0.0;
        }
    }

    public record ShadingResponse(List<double> ShadingFactors);
}
