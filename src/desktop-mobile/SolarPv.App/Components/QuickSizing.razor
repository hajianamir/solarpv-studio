@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory

<div class="card">
    <h1>SolarPV Studio — Quick PV Sizing</h1>
    <p>Phase 1 Vertical Slice: End-to-end solar array, battery storage, and financial LCOE sizing engine</p>
</div>

<div class="card">
    <h2>Project Location & Energy Requirements</h2>
    <div class="form-group">
        <label>Project Name</label>
        <input type="text" @bind="projectName" />
    </div>
    <div class="form-group">
        <label>Latitude (°)</label>
        <input type="number" @bind="latitude" step="0.0001" />
    </div>
    <div class="form-group">
        <label>Longitude (°)</label>
        <input type="number" @bind="longitude" step="0.0001" />
    </div>
    <div class="form-group">
        <label>Daily Consumption (kWh/day)</label>
        <input type="number" @bind="dailyKwh" step="0.5" />
    </div>
    <div class="form-group">
        <label>Autonomy Days (Days)</label>
        <input type="number" @bind="autonomyDays" step="0.5" />
    </div>

    <button @onclick="RunQuickSizing">Calculate System Sizing</button>

    @if (result != null)
    {
        <div class="result-box">
            <h3>Sizing Results for "@result.ProjectName"</h3>
            <p><strong>Project ID:</strong> @result.ProjectId</p>
            <p><strong>System Capacity:</strong> @result.SystemCapacityKwp.ToString("F2") kWp</p>
            <p><strong>Panel Count:</strong> @result.PanelCount x 575W N-Type Panels</p>
            <p><strong>Inverter Count:</strong> @result.InverterCount x 10kW String Inverters</p>
            <p><strong>Battery Bank Count:</strong> @result.BatteryCount x 10.2kWh LiFePO4 Units</p>
            <p><strong>Estimated Annual Generation:</strong> @result.EstimatedAnnualYieldKwh.ToString("N0") kWh/yr</p>
            <p><strong>Levelized Cost of Energy (LCOE):</strong> $@result.LcoeUsdPerKwh.ToString("F4") / kWh</p>
        </div>
    }
</div>

@code {
    private string projectName = "Tehran Villa System";
    private double latitude = 35.6895;
    private double longitude = 51.3890;
    private double dailyKwh = 20.0;
    private double autonomyDays = 1.5;
    private QuickSizingResponse? result;

    private async Task RunQuickSizing()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("SolarPvApi");
            var req = new QuickSizingRequest(
                projectName,
                latitude,
                longitude,
                dailyKwh,
                autonomyDays,
                Guid.Parse("11111111-1111-1111-1111-111111111111"),
                Guid.Parse("22222222-2222-2222-2222-222222222222"),
                Guid.Parse("33333333-3333-3333-3333-333333333333"));

            var res = await client.PostAsJsonAsync("/api/v1/projects/quick-size", req);
            if (res.IsSuccessStatusCode)
            {
                result = await res.Content.ReadFromJsonAsync<QuickSizingResponse>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error during sizing: {ex.Message}");
        }
    }

    public record QuickSizingRequest(string ProjectName, double Latitude, double Longitude, double DailyKwh, double AutonomyDays, Guid ModuleId, Guid InverterId, Guid BatteryId);
    public record QuickSizingResponse(Guid ProjectId, string ProjectName, double SystemCapacityKwp, int PanelCount, int InverterCount, int BatteryCount, double LcoeUsdPerKwh, double EstimatedAnnualYieldKwh);
}
