namespace solarpv_core {
    FfiSolarPosition solar_position(double latitude_deg, double longitude_deg, i64 utc_ts);
    double poa_irradiance(double ghi, double dni, double dhi, double tilt_deg, double azimuth_deg, double sun_zenith_deg, double sun_azimuth_deg);
    FfiStringSizingResult string_sizing(double panel_voc, double panel_vmp, double temp_min_c, double temp_max_c, double beta_voc_per_c, double inverter_vdc_max, double inverter_mppt_min, double inverter_mppt_max);
    double voltage_drop_dc(double length_m, double current_a, double cross_section_mm2, double v_nominal, double rho);
    double npv(double rate, sequence<double> cashflows);
    double irr(sequence<double> cashflows);
    double lcoe(double capex, double opex_annual, double energy_annual, double discount_rate, u32 lifetime_years);
};

dictionary FfiSolarPosition {
    double zenith_deg;
    double azimuth_deg;
};

dictionary FfiStringSizingResult {
    u32 min_modules;
    u32 max_modules;
    u8 has_warning;
};
