{
  "name": "solarpv-studio",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "start": "tsx server.ts",
    "start:prod": "npm run build && NODE_ENV=production tsx server.ts",
    "pc": "tsx scripts/run-pc.ts",
    "pc:prod": "npm run build && NODE_ENV=production tsx scripts/run-pc.ts",
    "dev": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit && npm run lint:eslint",
    "test": "tsx scripts/run-all-benchmarks.ts",
    "test:coverage": "c8 --include='src/engine/core/**' --exclude='src/engine/core/prng.ts' tsx scripts/run-all-benchmarks.ts",
    "test:smoke": "tsx scripts/smoke-test.ts",
    "verify-hubs": "tsx scripts/grep-verify-hubs.ts",
    "sync-docs": "tsx scripts/sync-docs.ts",
    "lint:eslint": "eslint src/"
  },
  "dependencies": {
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.174.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.13.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.174.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "c8": "^12.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
