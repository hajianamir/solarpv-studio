# ============================================================================
# SolarPV Studio — Environment Variables
# ============================================================================
# Copy this file to `.env` (or `.env.local` for overrides) and adjust as
# needed. The `.env` file is git-ignored.
# ============================================================================

# --- Live Global Climate Data Internet Fetching ---------------------------
# When set to `true`:
#   All climate data fetches MUST come from live external HTTP API providers
#   (NASA POWER Climatology for Americas / global; PVGIS 5.3 SARAH-2 for EMEA;
#   OpenStreetMap Nominatim / Overpass for geocoding).
#   Analytical fallback is STRICTLY DISABLED: if external APIs cannot be
#   reached, the request throws an explicit network error rather than silently
#   degrading to REGIONAL_ANALYTICAL_MODEL. This provides hard proof of live
#   satellite & reanalysis data retrieval.
#
# When set to `false` (default / air-gapped / sandbox):
#   All climate fetches safely use the calibrated physical clear-sky and
#   geographic analytical model (REGIONAL_ANALYTICAL_MODEL) with zero network
#   latency and zero external HTTP calls.
#
# Verification:
#   Run `npx tsx scripts/verify-real-internet.ts` or `npx tsx scripts/real-http-verify.ts`
#   to validate the runtime flag and provider routing.
#
# Frontend (Vite, browser-visible):
VITE_REAL_INTERNET=false

# Backend / Scripts (Node / tsx):
REAL_INTERNET=false

# --- Backend (Express, Node-only) -----------------------------------------
# Port the Express server listens on. Default: 3000.
PORT=3000

# Node runtime mode. `production` serves the built `dist/` bundle; any other
# value (or unset) starts the Vite dev middleware.
NODE_ENV=development
