# ============================================================================
# SolarPV Studio — Environment Variables
# ============================================================================
# Copy this file to `.env` (or `.env.local` for overrides) and adjust as
# needed. The `.env` file is git-ignored.
# ============================================================================

# --- Frontend (Vite, browser-visible) -------------------------------------
# When true, all climate fetches MUST come from real HTTP providers
# (NASA POWER / PVGIS) and the analytical fallback is DISABLED. Used by
# src/engine/env/runtimeEnv.ts and injected at build time by vite.config.ts.
VITE_REAL_INTERNET=false

# --- Backend (Express, Node-only) -----------------------------------------
# Port the Express server listens on. Default: 3000.
PORT=3000

# Node runtime mode. `production` serves the built `dist/` bundle; any other
# value (or unset) starts the Vite dev middleware.
NODE_ENV=development
