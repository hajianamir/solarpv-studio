# ============================================================================
# SolarPV Studio — Environment Variables
# ============================================================================
# Copy this file to `.env` (or `.env.local` for overrides) and adjust as
# needed. The `.env` file is git-ignored.
# ============================================================================

# --- Live Global Climate & Reference Data Internet Fetching ---------------
# DEFAULT: Automatic reference database queries (NASA POWER, PVGIS 5.3 SARAH-2,
# OpenStreetMap Nominatim / Overpass) are ACTIVE BY DEFAULT (no flag required).
#
# When external networks are reachable, measured satellite & reanalysis
# data is automatically retrieved with `isEstimatedFromGlobalModel: false`.
# If external networks are unreachable or rate-limited, the system gracefully
# falls back to the calibrated regional physical model (REGIONAL_ANALYTICAL_MODEL)
# with explicit audit provenance (`confidence: 'analytical_estimate'`).
#
# To explicitly OPT OUT (air-gapped / fully offline sandbox / no HTTP queries):
# Set `VITE_REAL_INTERNET=false` (frontend) and `REAL_INTERNET=false` (backend).
#
# Frontend (Vite, browser-visible):
# VITE_REAL_INTERNET=true

# Backend / Scripts (Node / tsx):
# REAL_INTERNET=true

# --- Backend (Express, Node-only) -----------------------------------------
# Port the Express server listens on. Default: 3000.
PORT=3000

# Node runtime mode. `production` serves the built `dist/` bundle; any other
# value (or unset) starts the Vite dev middleware.
NODE_ENV=development
