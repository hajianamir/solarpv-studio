# ============================================================================
# SolarPV Studio — Environment Variables
# ============================================================================
# Copy this file to `.env` (or `.env.local` for overrides) and adjust as
# needed. The `.env` file is git-ignored.
# ============================================================================

# --- Live Global Climate & Reference Data Internet Fetching ---------------
# DEFAULT: Automatic reference database queries (NASA POWER, PVGIS 5.3 SARAH-2,
# OpenStreetMap Nominatim / Overpass) are ACTIVE BY DEFAULT (no flag required).
#
# When external networks are reachable, provider-derived satellite/reanalysis
# data may be retrieved; this is not ground-station measurement. Provenance and
# uncertainty/coverage limitations must remain visible. If external networks are unreachable or rate-limited, the system gracefully
# falls back to the calibrated regional physical model (REGIONAL_ANALYTICAL_MODEL)
# with explicit audit provenance (`confidence: 'analytical_estimate'`).
#
# To explicitly OPT OUT (air-gapped / fully offline sandbox / no HTTP queries):
# Set `VITE_REAL_INTERNET=false` (frontend) and `REAL_INTERNET=false` (backend).
#
# Frontend (Vite, browser-visible):
# VITE_REAL_INTERNET=true

# Backend / Scripts (Node / tsx):
# REAL_INTERNET=true

# --- Backend (Express, Node-only) -----------------------------------------
# Port the Express server listens on. Default: 3000.
PORT=3000

# Node runtime mode. `production` serves the built `dist/` bundle; any other
# value (or unset) starts the Vite dev middleware.
NODE_ENV=development

# --- Production authentication policy (never commit real values) -------------
# Configure at least one trusted auth channel for production API identity.
# JWT_SECRET must be high-entropy and managed/rotated by a secrets manager.
# JWT access tokens must carry exp; tokens with > 24h remaining are rejected by default.
# Set JWT_ISSUER and JWT_AUDIENCE to the exact values from the trusted identity provider
# to enable issuer/audience verification; do not copy arbitrary claims from requests.
# JWT_SECRET=
# JWT_ISSUER=https://identity.example.invalid/
# JWT_AUDIENCE=solarpv-api
# JWT_MAX_TTL_SECONDS=86400
# INTERNAL_GATEWAY_SECRET=

# Enable only when the app is behind a correctly configured trusted reverse proxy;
# otherwise client-IP rate limits use the direct socket address and ignore forwarded headers.
# TRUST_PROXY=false
# JSON_BODY_LIMIT=2mb
# Public endpoint process-local limits: geocode 30/minute, report generation 20/minute.
# Multi-replica deployments need a shared API gateway/WAF limit as well.
